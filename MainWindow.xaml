<Window x:Class="CountdownDay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Width="300" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 菜单项内容 -->
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                    <!-- 如果有子菜单，右侧显示小箭头 ▸ -->
                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="▸" Foreground="#AAAAAA" Margin="12,0,0,0" 
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- 子菜单弹出框 Popup -->
                            <Popup x:Name="SubMenuPopup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="10" Padding="4" Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                                    </Border.Effect>
                                    <!-- 渲染子菜单列表 -->
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停高亮 -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#37373D"/>
                            </Trigger>
                            <!-- 当存在子菜单时，显示小箭头 -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3F3F46"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border x:Name="MainBackgroundBorder" CornerRadius="16" Background="#2D2D30">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
        </Border>

        <Grid x:Name="MainContentGrid" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="4,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource AppTitle}" Foreground="#E1E1E1" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                <Button Grid.Column="1" x:Name="BtnPin" Content="📌" Click="BtnPin_Click"
                        Foreground="#888888" Background="Transparent" BorderThickness="0"
                        FontSize="12" Padding="4,2" Cursor="Hand" ToolTip="{DynamicResource PinToolTip}"/>
            </Grid>

            <!-- 事件列表 -->
            <ItemsControl Grid.Row="1" x:Name="EventListView">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Background="#3E3E42" CornerRadius="8" Padding="10,8" Margin="0,3"
                                MouseLeftButtonDown="EventCard_MouseLeftButtonDown" Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource MenuEditCard}" Click="MenuEditItem_Click"/>
                                    <MenuItem Header="{DynamicResource MenuDeleteCard}" Click="MenuDeleteItem_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTitle" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Foreground="#888888" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="{DynamicResource DeadlinePrefix}"/>
                                        <Run Text="{Binding TargetDate, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="#A0A0A0" FontSize="11" Margin="0,1,0,0">
                                        <Run Text="{DynamicResource WorkDaysPrefix}"/>
                                        <Run Text="{Binding WorkDaysRemaining, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{DynamicResource DaysSuffix}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtDays" Text="{Binding TotalDaysRemaining, Mode=OneWay}" Foreground="#007ACC" 
                                               FontSize="22" FontWeight="Black"/>
                                    <TextBlock Text="{DynamicResource DaysSuffix}" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                <Setter TargetName="TxtTitle" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="TxtTitle" Property="Foreground" Value="#888888"/>
                                <Setter TargetName="TxtDays" Property="Foreground" Value="#D16969"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#333337"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 窗口右键菜单 -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{DynamicResource MenuAdd}" Click="MenuAdd_Click"/>
                <MenuItem Header="{DynamicResource MenuOpacity}" Click="MenuOpacity_Click"/>
                
                <!-- 语言切换二级菜单 -->
                <MenuItem Header="{DynamicResource MenuLanguage}">
                    <MenuItem x:Name="MenuLangZh" Header="简体中文" IsCheckable="True" Click="MenuLangZh_Click"/>
                    <MenuItem x:Name="MenuLangEn" Header="English" IsCheckable="True" Click="MenuLangEn_Click"/>
                </MenuItem>

                <MenuItem x:Name="MenuShowTaskbar" Header="{DynamicResource MenuTaskbarOn}" 
                          IsCheckable="True" Click="MenuShowTaskbar_Click"/>
                          
                <MenuItem Header="{DynamicResource MenuClearOld}" Click="MenuClearOld_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuExit}" Click="MenuExit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>